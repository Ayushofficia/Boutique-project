# Supabase project settings (Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string - used to sign the staff login session
STAFF_JWT_SECRET=change-this-to-a-long-random-string

# Storage bucket name used for uploaded photos (create this bucket in Supabase, mark it Public)
SUPABASE_STORAGE_BUCKET=photos
